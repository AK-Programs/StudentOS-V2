rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPERS & PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'student';
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email in [
          'naitik.kashyap0015@gmail.com',
          'naitik.kashyap5205@gmail.com',
          'superadmin@studentos.edu',
          'superadmin@veylentra.edu'
        ]
      );
    }

    function isParentOrGuardian() {
      return isSignedIn() && (userRole() in ['parent', 'guardian']);
    }

    function isFaculty() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        userRole() in ['teacher', 'faculty', 'head_teacher', 'coordinator', 'hod', 'admin', 'super_admin']
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        userRole() in ['admin', 'super_admin']
      );
    }

    // --- MATCH RULES ---

    // A. Users collection representing registered profiles (Strict No Cross-User visibility)
    match /users/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isFaculty());
      allow list: if isSignedIn() && isFaculty();
      allow create: if isSignedIn() && userId == request.auth.uid && (!('role' in incoming()) || incoming().role in ['student', 'parent', 'guardian']);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (userId == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'accountStatus', 'permissions', 'grant_all_permissions']))
      );
      allow delete: if isAdmin();

      // Orion & teacher command logs are strictly ephemeral — zero client persistence allowed
      match /teacherCommands/{commandId} {
        allow read, write: if false;
      }
    }

    // B. Checklists and academic logs tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isFaculty());
      allow write: if isSignedIn() && (
        (incoming() == null || incoming().userId == request.auth.uid) &&
        (existing() == null || existing().userId == request.auth.uid)
      );
    }

    // C. Student digital vaults and notes
    match /notes/{noteId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && (
        (incoming() == null || incoming().userId == request.auth.uid) &&
        (existing() == null || existing().userId == request.auth.uid)
      );
    }

    // D. Materials Hub directory documents (Role & visibility isolated)
    match /materials/{materialId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (
          !(resource.data.visibility in ['teacher', 'faculty', 'staff', 'private']) ||
          (resource.data.visibility in ['teacher', 'faculty', 'staff'] && isFaculty()) ||
          (resource.data.visibility == 'private' && (resource.data.uploaderUid == request.auth.uid || isAdmin()))
        )
      );
      allow create: if isSignedIn() && incoming().uploaderUid == request.auth.uid;
      allow update, delete: if isFaculty() || (isSignedIn() && existing().uploaderUid == request.auth.uid);
    }

    // E. Suggestions and peer logs
    match /feedbacks/{feedbackId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (isFaculty() || (incoming().votes == existing().votes + 1));
      allow delete: if isFaculty();
    }

    // F. Attendance registries (Faculty managed only)
    match /attendance/{dateStr} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // G. Announcements news flash (Faculty managed only)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // H. Chat messages collection (Personal Chat Filtered by ownerUid)
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow write: if isSignedIn() && (
        (incoming() == null || incoming().ownerUid == request.auth.uid) &&
        (existing() == null || existing().ownerUid == request.auth.uid)
      );
    }

    // I. Byte AI Buddy Collections (aiBuddyChats — strict owner isolation)
    match /aiBuddyChats/{chatId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && (
        (incoming() == null || incoming().userId == request.auth.uid) &&
        (existing() == null || existing().userId == request.auth.uid)
      );
    }

    // Student individual stats reports
    match /studentReports/{reportId} {
      allow read: if isSignedIn() && (reportId == request.auth.uid || isFaculty());
      allow write: if isSignedIn() && (reportId == request.auth.uid || isFaculty());
    }

    // Homework uploads
    match /hw_submissions/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.studentEmail == request.auth.token.email || isFaculty());
      allow write: if isSignedIn() && (incoming() == null || incoming().studentEmail == request.auth.token.email || isFaculty());
    }

    // Quiz records
    match /quizResults/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.studentEmail == request.auth.token.email || isFaculty());
      allow write: if isSignedIn() && (incoming() == null || incoming().studentEmail == request.auth.token.email || isFaculty());
    }

    // House standings (Faculty only)
    match /houseAnalytics/{houseId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Section standings (Faculty only)
    match /sectionAnalytics/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // House reward history (Faculty only)
    match /houseHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Warnings & Alerts (Faculty only)
    match /warnings/{warningId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // School worksheets, timetables, assignments and galleries (Faculty managed only)
    match /schoolResources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Orion chats are strictly ephemeral and forbidden for parents/guardians
    match /orionChats/{chatId} {
      allow read, write: if false;
    }

    // J. Notifications registry
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(notifId) && (incoming().userId == request.auth.uid || isFaculty());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isFaculty());
    }

    // K. Role Requests (Only Admin can approve/reject)
    match /roleRequests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['status', 'role']))
      );
      allow delete: if isAdmin();
    }

    // L. Staff Requests (Only Admin can approve/reject)
    match /staffRequests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['status', 'role']))
      );
      allow delete: if isAdmin();
    }

    // M. Profiles
    match /profiles/{profileId} {
      allow get: if isSignedIn() && (profileId == request.auth.uid || isFaculty());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(profileId) && profileId == request.auth.uid && incoming().role == 'student';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (profileId == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // N. FCM Tokens collection (Owner-scoped only)
    match /fcmTokens/{tokenId} {
      allow read: if isSignedIn() && (tokenId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
      allow create, update: if isSignedIn() && (tokenId == request.auth.uid || incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() && (tokenId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
    }
  }
}
