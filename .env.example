# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# VITE_GEMINI_API_KEY: Required for STATIC (Netlify/Vercel) client-only deployments.
# If you deploy to a static host without Node.js backend support, you MUST add this 
# environment variable to enable client-side AI fallback.
VITE_GEMINI_API_KEY=

# DEEPSEEK & OPENROUTER AI CONFIGURATION
# Direct DeepSeek API key:
DEEPSEEK_API_KEY=
# OpenRouter API key for DeepSeek models (e.g. deepseek/deepseek-chat, deepseek/deepseek-r1):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# SUPABASE
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VITE_ADMIN_PIN: Security PIN for Administrative/Teacher account logins. Default is 1234 if not set.
VITE_ADMIN_PIN=

# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# TAVILY_API_KEY: Web Search API key (used server-side in node context, e.g. server.ts)
TAVILY_API_KEY=

# VAPID KEYS FOR WEB PUSH & FCM NOTIFICATIONS
VAPID_PUBLIC_KEY=BJrzpoU4JY2uj2YmpzKKMoNsa5aHr_iL6rmLvG55NsGqInuYW1BzI1_6vYjz20GTx8qid6znkPbsVdMdppQ1uf4
VAPID_PRIVATE_KEY=

# STUDENTOS ANDROID APK DOWNLOAD DESTINATION (URL or path, e.g. https://... or /studentos-v3.12.apk)
VITE_STUDENTOS_APK_URL=
VITE_STUDENTOS_APK_FILENAME=
